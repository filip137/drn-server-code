{
  "lab": {
    "model_key": "fmnist",
    "dataset_key": "fmnist",
    "epochs": 100,
    "plots_dir": "plots/fmnist_hard_sigmoid_avg_pool_1readout"
  },
  "input_mode": "train",
  "lr": 0.02,
  "beta": 0.05,
  "log_interval": 50,
  "max_batches": 50000,
  "datasets": {
    "fmnist": {
      "factory": "labs.datasets.FashionMnistDataset",
      "params": {
        "name": "fmnist",
        "batch_size": 16,
        "root": "~/datasets/fashion_mnist",
        "train": true,
        "download": true,
        "normalize": true,
        "normalize_mean": 0.286,
        "normalize_std": 0.353
      }
    }
  },
  "model_base": {
    "weight_min": 1e-07,
    "weight_max": 100.0,
    "input_gain": 50.0,
    "voltage_amp": 4.0,
    "current_amp": 1.0,
    "non_linearity": "hard_sigmoid",
    "quadratic_diode_param": {
      "diode_conductance": 10,
      "v_min": -1.5,
      "v_max": 1.5
    },
    "hard_sigmoid_param": {
      "g_on": 10,
      "g_off": 0.1,
      "v_min": -1.2,
      "v_max": 1.2
    },
    "exponential_diode_param": {
      "I_s": 1e-06,
      "V_t": 0.05,
      "V_off": 1.0
    },
    "num_iterations_inference": 16,
    "num_iterations_training": 16
  },
  "model_overrides": {
    "fmnist": {
      "layer_shapes": [
        [
          2,
          28,
          28
        ],
        [
          32,
          26,
          26
        ],
        [
          32,
          13,
          13
        ],
        [
          64,
          11,
          11
        ],
        [
          64,
          5,
          5
        ],
        [
          20
        ]
      ],
      "conv_pipeline": [
        {
          "kernel": [
            3,
            3
          ],
          "stride": 1,
          "padding": 0,
          "mode": "convolution"
        },
        {
          "kernel": [
            2,
            2
          ],
          "stride": 2,
          "padding": 0,
          "mode": "pooling"
        },
        {
          "kernel": [
            3,
            3
          ],
          "stride": 1,
          "padding": 0,
          "mode": "convolution"
        },
        {
          "kernel": [
            2,
            2
          ],
          "stride": 2,
          "padding": 0,
          "mode": "pooling"
        }
      ],
      "pooling_mode": "avg",
      "weight_gains": [
        1,
        1,
        1,
        1,
        1
      ]
    }
  },
  "energy_minimizer": {
    "mode": "asynchronous"
  }
}
