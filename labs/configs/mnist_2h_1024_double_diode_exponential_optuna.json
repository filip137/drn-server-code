{
  "lab": {
    "model_key": "mnist",
    "epochs": 100,
    "plots_dir": "plots/mnist_2h_1024_hard_sigmoid_optuna"
  },
  "input_mode": "train",
  "lr": [
    0.1,
    0.1,
    0.05
  ],
  "beta": 0.05,
  "log_interval": 50,
  "max_batches": 50000,
  "datasets": {
    "mnist": {
      "factory": "labs.datasets.MnistDataset",
      "params": {
        "name": "mnist",
        "batch_size": 16,
        "root": "~/datasets/mnist",
        "train": true,
        "download": true,
        "normalize": true,
        "normalize_std": 0.3
      }
    }
  },
  "model_base": {
    "weight_min": 1e-7,
    "weight_max": 100.0,
    "input_gain": 50.0,
    "voltage_amp": 1.0,
    "current_amp": 1.0,
    "non_linearity": "hard_sigmoid",
    "quadratic_diode_param": {
      "diode_conductance": 10,
      "v_min": -1,
      "v_max": 1
    },
    "hard_sigmoid_param": {
      "g_on": 10,
      "g_off": 0.1,
      "v_min": -1.2,
      "v_max": 1.2
    },
    "exponential_diode_param": {
      "I_s": 1e-6,
      "V_t": 0.05,
      "V_off": 1.0
    },
    "num_iterations_inference": 12,
    "num_iterations_training": 12
  },
  "model_overrides": {
    "mnist": {
      "layer_shapes": [
        [
          2,
          28,
          28
        ],
        [
          1024
        ],
        [
          1024
        ],
        [
          20
        ]
      ],
      "conv_pipeline": [],
      "weight_gains": [
        1,
        1,
        1
      ],
      "input_gain": 50.0,
      "voltage_amp": 1.0,
      "current_amp": 1.0,
      "non_linearity": "hard_sigmoid",
      "hard_sigmoid_param": {
        "g_on": 10,
        "g_off": 0.1,
        "v_min": -1.2,
        "v_max": 1.2
      },
      "exponential_diode_param": {
        "I_s": 1e-6,
        "V_t": 0.05,
        "V_off": 1.0
      },
      "weight_min": 1e-7,
      "weight_max": 100.0,
      "num_iterations_inference": 12,
      "num_iterations_training": 12,
      "nudging": 0.05
    }
  },
  "energy_minimizer": {
    "mode": "asynchronous"
  }
}
