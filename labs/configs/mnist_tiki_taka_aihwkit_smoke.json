{
  "lab": {
    "model_key": "mnist",
    "dataset_key": "mnist",
    "epochs": 1
  },
  "device": "cpu",
  "input_mode": "train",
  "lr": [
    0.01,
    0.01,
    0.0
  ],
  "beta": 0.05,
  "log_interval": 1,
  "max_batches": 2,
  "max_test_batches": 1,
  "datasets": {
    "mnist": {
      "factory": "labs.datasets.MnistDataset",
      "params": {
        "name": "mnist",
        "batch_size": 2,
        "root": "~/datasets/mnist",
        "train": true,
        "download": true,
        "normalize": true,
        "normalize_mean": 0.1307,
        "normalize_std": 0.3081
      }
    }
  },
  "model_base": {
    "weight_min": 1e-07,
    "weight_max": 1.0,
    "input_gain": 10.0,
    "voltage_amp": 1.0,
    "current_amp": 1.0,
    "non_linearity": "hard_sigmoid",
    "quadratic_diode_param": {
      "diode_conductance": 10.0,
      "v_min": -1.0,
      "v_max": 1.0
    },
    "exponential_diode_param": {
      "I_s": 1e-06,
      "V_t": 0.05,
      "V_off": 1.0
    },
    "hard_sigmoid_param": {
      "g_on": 10.0,
      "g_off": 0.1,
      "v_min": -1.2,
      "v_max": 1.2
    },
    "num_iterations_inference": 2,
    "num_iterations_training": 2
  },
  "model_overrides": {
    "mnist": {
      "layer_shapes": [
        [
          2,
          28,
          28
        ],
        [
          8
        ],
        [
          20
        ]
      ],
      "conv_pipeline": [],
      "weight_gains": [
        1.0,
        1.0
      ]
    }
  },
  "energy_minimizer": {
    "mode": "asynchronous"
  },
  "update_pipeline": {
    "type": "tiki_taka",
    "fast_lr": 1.0,
    "transfer_every": 2,
    "units_in_mbatch": true,
    "n_reads_per_transfer": 1,
    "gamma": 0.0,
    "transfer_lr": 1.0,
    "scale_transfer_lr": true,
    "transfer_columns": true,
    "with_reset_prob": 0.0,
    "random_selection": false,
    "accumulate_biases": false,
    "aihwkit_preset": "TikiTakaReRamESPreset",
    "aihwkit_conductance_min": 1e-07,
    "aihwkit_conductance_max": 1.0,
    "aihwkit_construction_seed": 7
  }
}
