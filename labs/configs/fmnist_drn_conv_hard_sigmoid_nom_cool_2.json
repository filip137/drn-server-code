{
  "lab": {
    "model_key": "mnist",
    "dataset_key": "fmnist",
    "epochs": 50,
    "plots_dir": "plots/fmnist_drn_conv_hard_sigmoid_nom_cool_2"
  },
  "input_mode": "train",
  "lr": [
    0.015,
    0.09,
    0.15,
    0.015,
    0.09
  ],
  "beta": 0.02,
  "log_interval": 100,
  "datasets": {
    "fmnist": {
      "factory": "labs.datasets.FashionMnistDataset",
      "params": {
        "name": "fmnist",
        "batch_size": 10,
        "root": "~/datasets/fashion_mnist",
        "train": true,
        "download": true,
        "normalize": true,
        "normalize_mean": 0.286,
        "normalize_std": 0.353
      }
    }
  },
  "model_base": {
    "weight_min": 1e-07,
    "weight_max": 100.0,
    "input_gain": 50.0,
    "voltage_amp": 5.0,
    "current_amp": 1.0,
    "non_linearity": "hard_sigmoid",
    "quadratic_diode_param": {
      "diode_conductance": 10,
      "v_min": -1,
      "v_max": 1
    },
    "hard_sigmoid_param": {
      "g_on": 10,
      "g_off": 0.1,
      "v_min": -1.2,
      "v_max": 1.2
    },
    "exponential_diode_param": {
      "I_s": 1e-06,
      "V_t": 0.05,
      "V_off": 0.5
    },
    "num_iterations_inference": 8,
    "num_iterations_training": 12
  },
  "model_overrides": {
    "mnist": {
      "layer_shapes": [
        [
          2,
          28,
          28
        ],
        [
          32,
          26,
          26
        ],
        [
          64,
          24,
          24
        ],
        [
          20
        ]
      ],
      "conv_pipeline": [
        {
          "kernel": [
            3,
            3
          ],
          "stride": 1,
          "padding": 0,
          "mode": "convolution"
        },
        {
          "kernel": [
            3,
            3
          ],
          "stride": 1,
          "padding": 0,
          "mode": "convolution"
        }
      ],
      "weight_gains": [
        1,
        1,
        1,
        1,
        1
      ],
      "input_gain": 50.0,
      "voltage_amp": 5.0,
      "current_amp": 1.0,
      "non_linearity": "hard_sigmoid",
      "hard_sigmoid_param": {
        "g_on": 10,
        "g_off": 0.1,
        "v_min": -1.2,
        "v_max": 1.2
      },
      "exponential_diode_param": {
        "I_s": 1e-06,
        "V_t": 0.05,
        "V_off": 0.5
      },
      "weight_min": 1e-07,
      "weight_max": 100.0,
      "num_iterations_inference": 8,
      "num_iterations_training": 12,
      "nudging": 0.1
    }
  },
  "energy_minimizer": {
    "mode": "asynchronous"
  }
}
