from model.function.network import Network  # noqa: E402
from training.sgd import Backprop  # noqa: E402


EPS = 1e-12
LINE_FACTORS = (0.125, 0.25, 0.5, 1.0, 2.0, 4.0)


@dataclass(frozen=True)
class DiagnosticRow:
    label: str
    conv_depth: int
    non_linearity: str
    run_name: str
    voltage_amp: float
    current_amp: float
    input_gain: float
    T: int
    K: int
    learning_rate: float
    strides: tuple[int, ...]
    paddings: tuple[int, ...]
    affine_preset: str = "none"
    affine_seed: int = 1729
    affine_degrees: float | None = None
    affine_translate: tuple[float, ...] | None = None
    affine_scale: tuple[float, ...] | None = None
    affine_shear: float | None = None
    affine_config: dict | None = None


