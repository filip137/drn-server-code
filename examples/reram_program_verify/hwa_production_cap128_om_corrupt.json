        "maximum_batch": 32,
        "epsilon": 1e-8,
        "force_one_within_steps": 2
      },
      "surrogate": {
        "polynomial_order": 4,
        "standard_deviation_floor": 1e-8
      },
      "wan_comparison": {
        "g_max_us": 40,
        "noise_scale": 1
