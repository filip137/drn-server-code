{
  "schema_version": 1,
  "experiment_id": "ibm_reram_program_verify.v1",
  "runtime": {
    "device": "cuda",
    "dtype": "float32",
    "required_aihwkit_version": "1.1.0",
    "construction_seed": 72001,
    "conditioning_seed": 72002,
    "pulse_seed": 72003,
    "repeat_seed": 72007,
    "partition_seed": 72004,
    "analysis_seed": 72005,
    "wan_seed": 72006
  },
  "device": {
    "preset": "reram_array_om",
