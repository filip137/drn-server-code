{
  "schema_version": 1,
  "experiment_id": "mnist_relu_drn_kd.v1",
  "runtime": {
    "seed": 42,
    "data_seed": 42,
    "device": "cpu",
    "dtype": "float32"
  },
  "data": {
    "batch_size": 16,
    "validation_points": 5000,
    "num_points": null,
    "shuffle": true
  },
  "model": {
    "dims": [1568, 100, 20],
    "input_gain": 100.0,
    "conductance_min": 0.0,
    "conductance_max": 1.0,
    "voltage_amp": 4.0,
    "current_amp": 0.25,
    "encoding": "single",
    "include_biases": false,
    "non_linearity": {
      "type": "perfect_diode",
      "quadratic_diode_param": {},
      "exponential_diode_param": {},
      "hard_sigmoid_param": {}
    }
  },
  "solver": {
    "inference_iterations": 4,
    "training_iterations": 4,
    "mode": "asynchronous",
    "overrelaxation_factor": 1.1
