{
  "schema_version": 1,
  "experiment_id": "small_drn.v1",
  "runtime": {
    "seed": 42,
    "data_seed": 42,
    "device": "cuda",
    "dtype": "float32"
  },
  "data": {
    "dataset": "mnist",
    "batch_size": 16,
    "num_points": null,
    "shuffle": true
  },
  "model": {
    "dims": [1568, 100, 20],
    "input_gain": 50.0,
    "weight_gains": [1.0, 1.0],
    "weight_min": 1e-7,
    "weight_max": 1.0,
    "voltage_amp": 4.0,
    "current_amp": 0.25,
    "non_linearity": {
      "type": "perfect_diode",
      "quadratic_diode_param": {},
      "exponential_diode_param": {},
      "hard_sigmoid_param": {},
      "iv_data_path": null
    },
    "adapter": {
      "type": "none",
      "parameters": {}
    }
  },
  "solver": {
    "inference_iterations": 4,
    "training_iterations": 4,
    "minimizer_impl": "custom",
    "minimizer_mode": "asynchronous",
    "adaptive_equilibrium": false,
    "random_initialization": false,
    "updaters": {
      "double_diode": null,
      "single_diode": null
    },
    "tolerances": {
      "relative": 1e-5,
      "voltage": 1e-6,
      "residual_current": null
    },
    "polish": {
      "enabled": false,
      "dynamic": false,
      "max_newton_iterations": 32,
      "z_threshold": 1e10,
      "exponential_clip": 1e5
    },
    "anderson": {
      "memory": 8,
      "omega": 1.0,
      "tolerance_floor": 5e-3,
      "regularization": 1e-8
    },
    "overrelaxation": {
      "factor": 1.1,
      "reject_steps": false,
      "reject_max_tries": 3,
      "reject_shrink": 0.5,
      "reject_epsilon": 0.0
    },
    "experimental_exponential": {
      "damping": 0.5,
      "newton_max_steps": 100,
      "progressive_tolerance": true,
      "tolerance_start": 1e-5,
      "tolerance_end": 1e-5,
      "tolerance_switch_high": 1e-2,
      "tolerance_switch_low": 5e-4
    }
  },
  "modes": {
    "train": {
      "num_epochs": 10,
      "algorithm": "backprop",
      "learning_rates": [0.008, 0.005],
      "bias_learning_rates": [0.0],
      "nudging": 0.0,
      "log_every": 1,
      "max_batches": null,
      "max_validation_batches": null,
      "weight_modifier": {
        "type": "none",
        "parameters": {}
      },
      "update_backend": {
        "type": "program_verify",
        "parameters": {
          "device": {
            "type": "aihwkit_reram_wan2022_physical",
            "programming_seed": 17,
            "g_min_us": 1.0,
            "g_max_us": 40.0,
            "drn_conductance_at_g_max": 1.0,
            "noise_scale": 1.0,
            "t_inference_seconds": 86400.0,
            "mapping": "affine_floor"
          }
        }
      }
    },
    "validate": {
      "split": "test",
      "sample_limit": null,
      "record_states": false
    }
  }
}
