{
  "schema_version": 1,
  "experiment_id": "small_drn.v1",
  "runtime": {
    "seed": 7,
    "data_seed": 11,
    "device": "cpu",
    "dtype": "float32"
  },
  "data": {
    "dataset": "digits",
    "batch_size": 64,
    "num_points": null,
    "shuffle": true
  },
  "model": {
    "dims": [128, 20],
    "input_gain": 1.0,
    "weight_gains": [0.1],
    "weight_min": 1e-7,
    "weight_max": 1.0,
    "voltage_amp": 1.0,
    "current_amp": 1.0,
    "non_linearity": {
      "type": "linear",
      "quadratic_diode_param": {
        "diode_conductance": 10.0,
        "v_min": -1.0,
        "v_max": 1.0
      },
      "exponential_diode_param": {
        "I_s": 1e-6,
        "V_t": 0.05,
        "V_off": 1.0
      },
      "hard_sigmoid_param": {
        "g_on": 10.0,
        "g_off": 0.1,
        "v_min": -1.2,
        "v_max": 1.2
      },
      "iv_data_path": null
    },
    "adapter": {
      "type": "digital_low_rank",
      "parameters": {
        "rank": 4,
        "alpha": 4.0,
        "input_factor_gain": 1.0,
        "device_noise": {
          "type": "aihwkit_reram_wan2022",
          "programming_seed": 17,
          "g_max_us": 40.0,
          "drn_conductance_at_g_max": 0.1,
          "noise_scale": 1.0,
          "t_inference_seconds": 1.0
        }
      }
    }
  },
  "solver": {
    "inference_iterations": 8,
    "training_iterations": 8,
    "minimizer_impl": "custom",
    "minimizer_mode": "asynchronous",
    "adaptive_equilibrium": false,
    "random_initialization": false,
    "updaters": {
      "double_diode": null,
      "single_diode": null
    },
    "tolerances": {
      "relative": 1e-5,
      "voltage": 1e-6,
      "residual_current": null
    },
    "polish": {
      "enabled": false,
      "dynamic": false,
      "max_newton_iterations": 32,
      "z_threshold": 1e10,
      "exponential_clip": 1e5
    },
    "anderson": {
      "memory": 8,
      "omega": 1.0,
      "tolerance_floor": 5e-3,
      "regularization": 1e-8
    },
    "overrelaxation": {
      "factor": 1.0,
      "reject_steps": false,
      "reject_max_tries": 3,
      "reject_shrink": 0.5,
      "reject_epsilon": 0.0
    },
    "experimental_exponential": {
      "damping": 0.5,
      "newton_max_steps": 100,
      "progressive_tolerance": true,
      "tolerance_start": 1e-5,
      "tolerance_end": 1e-5,
      "tolerance_switch_high": 1e-2,
      "tolerance_switch_low": 5e-4
    }
  },
  "modes": {
    "train": {
      "num_epochs": 10,
      "algorithm": "digital",
      "learning_rates": [0.01, 0.01],
      "bias_learning_rates": [],
      "nudging": 0.0,
      "log_every": 1,
      "max_batches": null,
      "max_validation_batches": null,
      "weight_modifier": {
        "type": "none",
        "parameters": {}
      },
      "update_backend": {
        "type": "direct",
        "parameters": {}
      }
    },
    "validate": {
      "split": "test",
      "sample_limit": null,
      "record_states": false
    }
  }
}
