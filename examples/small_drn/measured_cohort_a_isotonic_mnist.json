      "newton_max_steps": 100,
      "progressive_tolerance": true,
      "tolerance_start": 1e-5,
      "tolerance_end": 1e-5,
      "tolerance_switch_high": 1e-2,
      "tolerance_switch_low": 5e-4
    }
  },
  "modes": {
    "train": {
      "num_epochs": 20,
      "algorithm": "backprop",
      "learning_rates": [0.0, 0.0],
