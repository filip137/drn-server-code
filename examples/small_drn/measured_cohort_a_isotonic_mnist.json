{
  "schema_version": 1,
  "experiment_id": "small_drn.v1",
  "runtime": {
    "seed": 42,
    "data_seed": 42,
    "device": "cuda",
    "dtype": "float32"
  },
  "data": {
    "dataset": "mnist",
    "batch_size": 16,
    "num_points": null,
    "validation_points": 5000,
    "shuffle": true
  },
  "model": {
    "dims": [1568, 100, 20],
    "input_gain": 100.0,
    "weight_gains": [1.0, 1.0],
    "weight_min": 0.0,
    "weight_max": 0.00011,
    "voltage_amp": 4.0,
    "current_amp": 0.25,
    "non_linearity": {
      "type": "perfect_diode",
      "quadratic_diode_param": {},
      "exponential_diode_param": {},
      "hard_sigmoid_param": {},
