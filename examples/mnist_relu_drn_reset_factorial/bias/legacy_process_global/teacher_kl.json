{
  "schema_version": 1,
  "experiment_id": "mnist_relu_drn_reset_factorial.v1",
  "runtime": {
    "seed": 42,
    "data_seed": 42,
    "device": "cuda",
    "dtype": "float32"
  },
  "data": {
    "batch_size": 16,
    "validation_points": 5000,
    "num_points": null,
    "shuffle": true
  },
  "model": {
    "dims": [
      1568,
      100,
      20
    ],
    "input_gain": 100,
    "conductance_min": 0,
    "conductance_max": 0.00011,
    "voltage_amp": 4,
    "current_amp": 0.25,
    "encoding": "single",
    "include_biases": true,
    "amplification_indexing": "legacy_process_global",
    "non_linearity": {
      "type": "perfect_diode",
      "quadratic_diode_param": {},
      "exponential_diode_param": {},
      "hard_sigmoid_param": {}
    }
  },
  "solver": {
    "inference_iterations": 4,
    "training_iterations": 4,
    "mode": "asynchronous",
    "overrelaxation_factor": 1.1
  },
  "modes": {
    "train": {
      "objective": "teacher_kl",
      "num_epochs": 20,
      "learning_rate_selection": {
        "type": "bounded_relative_update_grid",
        "parameters": {
          "probe_batches": [
            32,
            64,
            128
          ],
          "stability_tolerance": 0.1,
          "weight_relative_update_targets": [
            0.003,
            0.01
          ],
          "bias_quantile": 0.9,
          "canary_batches": 640,
          "candidate_epochs": 3,
          "grid_multipliers": [
            0.3333333333333333,
            1,
            3
          ],
          "max_center_reductions": 6,
          "plateau_relative_tolerance": 0.02,
          "safety": {
            "warmup_batches": 32,
            "loss_ema_decay": 0.98,
            "loss_growth_factor": 4,
            "gradient_growth_factor": 100,
            "persistence_batches": 8
          }
        }
      },
      "initialization": {
        "type": "measured_reset",
        "parameters": {}
      },
      "logit_gain": {
        "type": "fixed",
        "value": 1
      },
      "temperature": 1,
      "reset_input_between_batches": true,
      "log_every": 1,
      "max_batches": null,
      "max_validation_batches": null,
      "minimum_validation_accuracy": 0,
      "update_backend": {
        "type": "measured_cohort_a",
        "parameters": {
          "curve_preprocessing": "raw",
          "split_seed": 42,
          "assignment_seed": 42,
          "formed_resistance_max_ohm": 30000,
          "cohort_fraction": 0.5,
          "cohort": "A",
          "source_traces_per_cell": 2,
          "initial_pulse_index": 0,
          "projection": "global_nearest",
          "expected_trace_length": 5000
        }
      }
    },
    "validate": {
      "objective": "teacher_kl",
      "split": "test",
      "sample_limit": null
    }
  }
}
